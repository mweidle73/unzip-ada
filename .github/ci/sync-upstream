#!/bin/sh

set -eu

UPSTREAM_URL=${ZIP_ADA_UPSTREAM_URL:-https://github.com/zertovitch/zip-ada.git}

git remote remove official 2>/dev/null || true
git remote add official "$UPSTREAM_URL"
git fetch --no-tags origin refs/heads/master:refs/remotes/origin/master
git fetch --no-tags official refs/heads/master:refs/remotes/official/master

mirror_tags=$(mktemp)
upstream_tags=$(mktemp)
trap 'rm -f "$mirror_tags" "$upstream_tags"' EXIT
list_tags() {
    git ls-remote --tags "$1" |
        awk '$2 !~ /\^\{\}$/ {
            name = $2
            sub("^refs/tags/", "", name)
            print name "\t" $1
        }' |
        LC_ALL=C sort
}
list_tags origin > "$mirror_tags"
list_tags official > "$upstream_tags"
if ! diff -u "$mirror_tags" "$upstream_tags"; then
    echo "Official Zip-Ada tag refs require manual mirror review" >&2
    exit 1
fi
echo "Mirror tag refs match official upstream (currently none)"

mirror_commit=$(git rev-parse refs/remotes/origin/master)
upstream_commit=$(git rev-parse refs/remotes/official/master)

if [ "$mirror_commit" = "$upstream_commit" ]; then
    echo "Mirror master already matches official upstream at $mirror_commit"
    exit 0
fi

if ! git merge-base --is-ancestor "$mirror_commit" "$upstream_commit"; then
    echo "Official Zip-Ada master does not fast-forward the mirror:" >&2
    echo "  Mirror:   $mirror_commit" >&2
    echo "  Official: $upstream_commit" >&2
    echo "Refusing to rewrite history automatically" >&2
    exit 1
fi

git push origin "$upstream_commit:refs/heads/master"
echo "Fast-forwarded mirror master to $upstream_commit"
